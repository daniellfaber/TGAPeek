<Project>
  <!--
    A small TGAPeek.exe (plus its DLLs) that uses the .NET 10 Desktop Runtime installed on the PC.
    It sets no runtime identifier, so it builds with what the SDK already has and downloads nothing.
    For testing on a PC with .NET 10 installed; the distribution build is win-x64-self-contained.
    dotnet publish src/TGAPeek.App -p:PublishProfile=win-x64-framework-dependent
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <SelfContained>false</SelfContained>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\artifacts\publish\win-x64-framework-dependent\</PublishDir>
  </PropertyGroup>
</Project>
