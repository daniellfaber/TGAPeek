<Project>
  <!--
    As win-x64-self-contained, but the single file is compressed: about 49 MB instead of 107 MB,
    at the cost of about 80 ms and 44 MB of memory on every start (measured 2026-10-25). Not the
    default; zipping the plain build gives a similar download size without the run-time cost.
    dotnet publish src/TgaViewer.App -p:PublishProfile=win-x64-self-contained-compressed
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>.xml</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\artifacts\publish\win-x64-self-contained-compressed\</PublishDir>
  </PropertyGroup>
</Project>
