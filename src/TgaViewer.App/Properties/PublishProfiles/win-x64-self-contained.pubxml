<Project>
  <!--
    The distribution build: one self-contained TgaViewer.exe for 64-bit Windows that needs no
    separate .NET installation. The first publish downloads the win-x64 runtime packs from
    nuget.org (once, into the NuGet cache). The runtime's licence notices are copied into
    licenses\ beside the exe (see TgaViewer.App.csproj).
    Not compressed: compression saved 58 MB of file size but added about 80 ms and 44 MB of
    memory to every start (measured 2026-10-25, IMPLEMENTATION_PLAN.md section 14).
    Not trimmed: the SDK rejects trimming for Windows Forms as unsupported.
    dotnet publish src/TgaViewer.App -p:PublishProfile=win-x64-self-contained
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- The viewer's interface is English, so Windows Forms' translated messages are left out (9 MB). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- No symbol files beside the exe, including the referenced TgaViewer.Core's. -->
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>.xml</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\artifacts\publish\win-x64-self-contained\</PublishDir>
  </PropertyGroup>
</Project>
